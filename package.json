{
  "name": "needlecast",
  "productName": "Needlecast",
  "version": "0.3.0-alpha.6",
  "description": "A local-first turntable-to-Discord desktop app with music EQ, rumble filtering, peak protection, album artwork, album-level bot presence, and optional bot avatar artwork.",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "author": "Needlecast contributors",
  "scripts": {
    "start": "electron .",
    "start:server": "node server.js",
    "check": "node --check server.js && node --check public/app.js && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check src/main/services/discogs-service.cjs && node --check src/main/services/library-service.cjs && node --check src/main/services/album-artwork-service.cjs && node --check src/main/services/bot-avatar-service.cjs",
    "test": "node --test tests/*.test.cjs",
    "build:capture-agent": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-capture-agent.ps1",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --dir"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.22.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "opusscript": "^0.0.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.needlecast.desktop",
    "productName": "Needlecast",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "server.js",
      "src/**/*",
      "package.json",
      "!capture-agent/**/*",
      "!tests/**/*",
      "!scripts/**/*",
      "!docker-compose.yml",
      "!Dockerfile",
      "!install-windows.ps1",
      "!cli-windows.ps1",
      "!README.md",
      "!.env*"
    ],
    "extraResources": [
      {
        "from": "build-resources/capture-agent",
        "to": "capture-agent",
        "filter": [
          "needlecast-capture-agent.exe"
        ]
      },
      {
        "from": "build-resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Needlecast-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Needlecast",
      "deleteAppDataOnUninstall": false
    }
  }
}
